{
  "version": 6,
  "include": [
    "../config/layout.json",
    "../config/ninja.json",
    "../config/debug.json",
    "../config/release.json",
    "../compiler/gcc.json",
    "../host/x64-linux.json"
  ],
  "configurePresets": [
    {
      "name": "x64-linux-gcc-debug",
      "inherits": [
        "config-layout",
        "config-ninja",
        "config-debug",
        "compiler-gcc",
        "host-x64-linux"
      ]
    },
    {
      "name": "x64-linux-gcc-release",
      "inherits": [
        "config-layout",
        "config-ninja",
        "config-release",
        "compiler-gcc",
        "host-x64-linux"
      ]
    }
  ],
  "buildPresets": [
    {
      "name": "x64-linux-gcc-debug",
      "configurePreset": "x64-linux-gcc-debug"
    },
    {
      "name": "x64-linux-gcc-release",
      "configurePreset": "x64-linux-gcc-release"
    }
  ],
  "testPresets": [
    {
      "name": "x64-linux-gcc-debug",
      "configurePreset": "x64-linux-gcc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "x64-linux-gcc-release",
      "configurePreset": "x64-linux-gcc-release",
      "output": {
        "outputOnFailure": true
      }
    }
  ],
  "workflowPresets": [
    {
      "name": "x64-linux-gcc-debug",
      "steps": [
        {
          "type": "configure",
          "name": "x64-linux-gcc-debug"
        },
        {
          "type": "build",
          "name": "x64-linux-gcc-debug"
        },
        {
          "type": "test",
          "name": "x64-linux-gcc-debug"
        }
      ]
    },
    {
      "name": "x64-linux-gcc-release",
      "steps": [
        {
          "type": "configure",
          "name": "x64-linux-gcc-release"
        },
        {
          "type": "build",
          "name": "x64-linux-gcc-release"
        },
        {
          "type": "test",
          "name": "x64-linux-gcc-release"
        }
      ]
    }
  ]
}
